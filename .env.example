# Artifex local infrastructure — copy to `.env` and adjust as needed.
# docker-compose reads this file automatically. `.env` is gitignored; only this
# template is committed.

# --- Postgres (Memory Fabric: audit ledger, asset registry, knowledge commons) ---
POSTGRES_USER=artifex
POSTGRES_PASSWORD=artifex
POSTGRES_DB=artifex
# Host-published port. Defaults to 5433 so it doesn't collide with a local
# Postgres already on 5432. The container always listens on 5432 internally.
POSTGRES_PORT=5433

# --- Redis (Job Queue / BullMQ) ---
REDIS_PORT=6379

# --- Ollama (local OpenAI-compatible model backend, dev tier) ---
OLLAMA_PORT=11434
